<Window x:Class="Registration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1">
            <StackPanel HorizontalAlignment="Right" Margin="15,10">
                <Button x:Name="btnBack" Content="← Назад" Click="btnBack_Click" Visibility="Collapsed" Padding="12,8" Width="120"/>
            </StackPanel>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"
               Background="{StaticResource DarkBackground}"/>
    </Grid>
</Window>