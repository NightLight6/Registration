<Window x:Class="Registration.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Система управления" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource DarkBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Height="60">
            <Grid Margin="15,0">
                <Button x:Name="btnBack"  Content="← Назад" Click="btnBack_Click" 
                        Visibility="Collapsed" Width="100" Height="35" HorizontalAlignment="Left" 
                        FontSize="13" Padding="5,0" Background="Transparent" 
                        Foreground="{StaticResource TextPrimary}" BorderThickness="0"/>

                <StackPanel x:Name="spUserControls" Orientation="Horizontal" HorizontalAlignment="Right" Visibility="Collapsed">
                    <TextBlock x:Name="tblUserName" Text="Пользователь" Foreground="White" 
                               VerticalAlignment="Center" Margin="0,0,15,0" FontWeight="SemiBold"/>

                    <Button x:Name="btnProfile" Click="btnProfile_Click" Width="40" Height="40" 
                            Background="{StaticResource PrimaryColor}" BorderThickness="0" Cursor="Hand" ToolTip="Личный кабинет">
                        <Button.Clip>
                            <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                        </Button.Clip>
                        <TextBlock Text="👤" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0"/>
                    </Button>

                    <Button x:Name="btnLogout" Content="Выйти" Click="btnLogout_Click" 
                            Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}" 
                            Margin="15,0,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <Frame x:Name="MainFrame"
               Grid.Row="1"
               NavigationUIVisibility="Hidden"
               Navigated="MainFrame_Navigated"
               Background="{StaticResource DarkBackground}"/>
    </Grid>
</Window>