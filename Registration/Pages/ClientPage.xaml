<Page x:Class="Registration.Pages.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Registration.Services"
      Title="Каталог товаров"
      Background="{StaticResource DarkBackground}">

    <Page.Resources>
        <converters:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter" />
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="25" 
                Margin="0,0,0,25"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <TextBlock Text="🛍️ Каталог товаров"  
                       FontSize="28" 
                       FontWeight="Bold"  
                       HorizontalAlignment="Center" 
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <Border Grid.Row="1" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1"
                Padding="15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>

            <ListView Name="LvProducts" 
                      Background="Transparent"
                      BorderThickness="0"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.IsVirtualizing="False">

                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" 
                                CornerRadius="12" 
                                Margin="10" 
                                Padding="25" 
                                Background="{StaticResource DarkCard}"
                                MinHeight="160">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15" Color="Black"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" 
                                        Width="120" 
                                        Height="120" 
                                        CornerRadius="12" 
                                        Background="{StaticResource DarkSurface}"
                                        BorderBrush="{StaticResource BorderColor}"
                                        BorderThickness="1"
                                        Margin="0,0,25,0">
                                    <Image Source="{Binding PhotoPath, Converter={StaticResource ImagePathToImageSourceConverter}}" 
                                           Width="118" 
                                           Height="118" 
                                           Stretch="UniformToFill"
                                           ClipToBounds="True">
                                        <Image.Clip>
                                            <RectangleGeometry Rect="0,0,118,118" RadiusX="11" RadiusY="11"/>
                                        </Image.Clip>
                                    </Image>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Bold" 
                                               FontSize="22" 
                                               Foreground="{StaticResource TextPrimary}" 
                                               Margin="0,0,0,12"/>
                                    <TextBlock Text="{Binding Description}" 
                                               TextWrapping="Wrap" 
                                               Margin="0,0,0,15" 
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="15"
                                               MaxHeight="80"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Категория: " 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{StaticResource TextSecondary}"
                                                   FontSize="15"/>
                                        <TextBlock Text="{Binding ProductCategories.CategoryName, TargetNullValue='Без категории'}" 
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontSize="15"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Price, StringFormat='💰 Цена: {0:F2} руб.'}" 
                                               FontSize="22" 
                                               Foreground="{StaticResource SuccessColor}" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>
    </Grid>
</Page>