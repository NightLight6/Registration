<Page x:Class="Registration.Pages.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:converters="clr-namespace:Registration.Services"
      Title="Каталог товаров"
      Background="White">

    <Page.Resources>
        <converters:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Каталог товаров"  FontSize="24" FontWeight="Bold"  HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <ListView Name="LvProducts" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding PhotoPath, Converter={StaticResource ImagePathToImageSourceConverter}}" Width="40" Height="40" Stretch="UniformToFill" />

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Категория: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductCategories.CategoryName}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:F2} руб.'}" FontSize="14" Foreground="Green"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>