<Page x:Class="Registration.Pages.ProductEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Pages"
      xmlns:converters="clr-namespace:Registration.Services"
      mc:Ignorable="d" 
      d:DesignHeight="964.8" d:DesignWidth="800"
      Title="Добавление/Редактирование товара"
      Background="{StaticResource DarkBackground}">

    <Page.Resources>
        <converters:ImagePathToImageSourceConverter x:Key="ImagePathConverter" />
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0"
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="25" 
                Margin="0,0,0,25"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <TextBlock x:Name="TitleTextBlock"
                       Text="Добавление товара"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource TextPrimary}"/>
        </Border>

        <!-- Форма редактирования -->
        <Border Grid.Row="1" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="35"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel MaxWidth="700" HorizontalAlignment="Center">
                    <!-- Фото товара -->
                    <TextBlock Text="Фото товара" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,12" 
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="14"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" 
                                Width="160" 
                                Height="160" 
                                CornerRadius="12" 
                                Background="{StaticResource DarkCard}"
                                BorderBrush="{StaticResource BorderColor}"
                                BorderThickness="2"
                                Margin="0,0,20,0">
                            <Grid>
                                <Image x:Name="imgPhoto" 
                                       Source="{Binding ImagePath, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource ImagePathConverter}}"
                                       Width="156" 
                                       Height="156"
                                       Stretch="UniformToFill"
                                       ClipToBounds="True">
                                    <Image.Clip>
                                        <RectangleGeometry Rect="0,0,156,156" RadiusX="10" RadiusY="10"/>
                                    </Image.Clip>
                                </Image>
                                <TextBlock x:Name="lblPlaceholder" 
                                           Text="Нет фото" 
                                           VerticalAlignment="Center" 
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource TextSecondary}" 
                                           Margin="0,0,0,10"
                                           Visibility="Collapsed"
                                           FontSize="14"/>
                            </Grid>
                        </Border>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Button Content="Выбрать фото..." 
                                    Click="BtnSelectImage_Click" 
                                    Padding="18,12" 
                                    Width="200"
                                    Height="48"
                                    FontSize="14"
                                    Margin="0,0,0,10"/>
                            <TextBlock Text="Рекомендуемый размер: 400x400px" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Название товара*" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10" 
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="14"/>
                    <TextBox x:Name="TxtName" 
                             Padding="15,12" 
                             Margin="0,0,0,25" 
                             Height="48"
                             FontSize="15"/>

                    <TextBlock Text="Описание" 
                               FontWeight="SemiBold" 
                               Margin="0,0,0,10" 
                               Foreground="{StaticResource TextSecondary}"
                               FontSize="14"/>
                    <TextBox x:Name="TxtDescription" 
                             AcceptsReturn="True" 
                             Height="120" 
                             Padding="15,12" 
                             Margin="0,0,0,25" 
                             TextWrapping="Wrap"
                             FontSize="14"/>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Категория*" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"/>
                            <ComboBox x:Name="CmbCategory" 
                                      DisplayMemberPath="CategoryName" 
                                      SelectedValuePath="CategoryID" 
                                      Height="48"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Тип напитка*" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"/>
                            <ComboBox x:Name="CmbBeverageType" 
                                      DisplayMemberPath="Name" 
                                      SelectedValuePath="BeverageTypeID" 
                                      Height="48"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,25">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Себестоимость (руб.)" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"/>
                            <TextBox x:Name="TxtCostPrice" 
                                     Padding="15,12" 
                                     Height="48"
                                     FontSize="15"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Цена (руб.)*" 
                                       FontWeight="SemiBold" 
                                       Margin="0,0,0,10" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="14"/>
                            <TextBox x:Name="TxtPrice" 
                                     Padding="15,12" 
                                     Height="48"
                                     FontSize="15"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox x:Name="ChkIsAvailable" 
                              Content="Товар доступен для продажи" 
                              Margin="0,0,0,30" 
                              Foreground="{StaticResource TextPrimary}"
                              FontSize="14"
                              FontWeight="SemiBold"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Сохранить" 
                                Click="BtnSave_Click" 
                                Padding="20,12" 
                                Margin="0,0,15,0" 
                                Width="150"
                                Height="50"
                                FontSize="15"
                                FontWeight="Bold"/>
                        <Button Content="Очистить" 
                                Click="BtnClear_Click" 
                                Padding="20,12" 
                                Width="140"
                                Height="50"
                                FontSize="15"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
