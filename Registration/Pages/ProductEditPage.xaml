<Page x:Class="Registration.Pages.ProductEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Pages"
      xmlns:converters="clr-namespace:Registration.Services"
      mc:Ignorable="d" 
      d:DesignHeight="964.8" d:DesignWidth="800"
      Title="Добавление/Редактирование товара"
      Background="White">

    <Page.Resources>
        <converters:ImagePathToImageSourceConverter x:Key="ImagePathConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleTextBlock"
                   Text="Добавление товара"
                   FontSize="24"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <TextBlock Text="Фото товара" FontWeight="Bold" Margin="0,0,0,5"/>
                <Image x:Name="imgPhoto" 
                       Source="{Binding ImagePath, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource ImagePathConverter}}"
                       Width="120" Height="120"
                       HorizontalAlignment="Left"
                       Stretch="UniformToFill"
                       Margin="0,0,0,10"/>
                <TextBlock x:Name="lblPlaceholder" 
                           Text="Нет фото" 
                           VerticalAlignment="Center" 
                           Foreground="Gray" 
                           Margin="0,0,0,10"
                           Visibility="Collapsed"/>
                <Button Content="Выбрать фото..." Click="BtnSelectImage_Click"  Padding="5"  Background="Purple"  Foreground="White"  HorizontalAlignment="Left"  Margin="0,0,0,20"/>

                <TextBlock Text="Название товара*" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtName" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Описание" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtDescription" AcceptsReturn="True" Height="80" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Категория*" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbCategory" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryID" Margin="0,0,0,15"/>

                <TextBlock Text="Тип напитка*" FontWeight="Bold" Margin="0,0,0,5"/>
                <ComboBox x:Name="CmbBeverageType" DisplayMemberPath="Name" SelectedValuePath="BeverageTypeID" Margin="0,0,0,15"/>

                <TextBlock Text="Себестоимость (руб.)" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtCostPrice" Padding="5" Margin="0,0,0,15"/>

                <CheckBox x:Name="ChkIsAvailable" Content="Доступен" Margin="0,0,0,15"/>

                <TextBlock Text="Цена (руб.)*" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="TxtPrice" Padding="5" Margin="0,0,0,20"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Сохранить" Click="BtnSave_Click"  Background="Purple" Foreground="White" Padding="8,4" Margin="0,0,10,0" Width="100"/>
                    <Button Content="Очистить" Click="BtnClear_Click" Background="Purple" Foreground="White" Padding="8,4" Width="100"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>