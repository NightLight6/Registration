<Page x:Class="Registration.Pages.ProductListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:Registration.Services"
      Title="Управление товарами"
      Background="White">

    <Page.Resources>
        <local:ImagePathToImageSourceConverter x:Key="ImagePathToImageSourceConverter" />
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
            <Button Content="Добавить товар" 
                    Click="BtnAdd_Click" 
                    Background="Purple" 
                    Foreground="White"
                    Padding="8,4" Width="160"/>
        </StackPanel>

        <ListView Name="LvProducts" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#ccc" BorderThickness="1" CornerRadius="5" Margin="5" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Image Source="{Binding PhotoPath, Converter={StaticResource ImagePathToImageSourceConverter}}" 
                                   Width="60" Height="60" 
                                   Stretch="UniformToFill" 
                                   Margin="0,0,10,0"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Категория: " FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ProductCategories.CategoryName}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Price, StringFormat='Цена: {0:F2} руб.'}" FontSize="14" Foreground="Green"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                                <Button Content="Редактировать" 
                                        Tag="{Binding}" 
                                        Click="BtnEdit_Click"
                                        Background="Orange" 
                                        Foreground="White"
                                        Padding="5,2" 
                                        Margin="0,0,0,2"/>
                                <Button Content="Удалить" 
                                        Tag="{Binding}" 
                                        Click="BtnDelete_Click"
                                        Background="Red" 
                                        Foreground="White"
                                        Padding="5,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>