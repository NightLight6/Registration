<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="Registration.Pages.RegistrationPage"
    Title="Регистрация нового пользователя"
    Background="{StaticResource DarkBackground}" 
    av:DesignHeight="1200">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" 
                    Background="{StaticResource DarkSurface}" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="0,0,0,1" 
                    Padding="30,25">
                <TextBlock Text="Регистрация нового пользователя" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource TextPrimary}"/>
            </Border>

            <Border Grid.Row="1" 
                    Margin="30" 
                    Background="{StaticResource DarkSurface}" 
                    CornerRadius="16" 
                    Padding="40" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Border.Effect>

                <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Фамилия*" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtSurname" Grid.Row="1" Grid.Column="0" Margin="0,0,10,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Имя*" Grid.Row="0" Grid.Column="1" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="10,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Отчество" Grid.Row="2" Grid.ColumnSpan="2" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtOtchestvo" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Логин*" Grid.Row="4" Grid.ColumnSpan="2" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtLogin" Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Email" Grid.Row="6" Grid.ColumnSpan="2" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtEmail" Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Телефон" Grid.Row="8" Grid.Column="0" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtPhone" Grid.Row="9" Grid.Column="0" Margin="0,0,10,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                        <TextBlock Text="Должность" Grid.Row="8" Grid.Column="1" Foreground="{StaticResource TextSecondary}" Margin="10,0,0,8" FontWeight="SemiBold"/>
                        <TextBox x:Name="txtPosition" Grid.Row="9" Grid.Column="1" Margin="10,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>
                    </Grid>

                    <TextBlock Text="Пароль*" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <PasswordBox x:Name="txtPassword" Margin="0,0,0,25" Height="70" VerticalContentAlignment="Center" Padding="10,0"/>

                    <TextBlock Text="Статус" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbStatus" SelectedIndex="0" Margin="0,0,0,25" Height="70" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Активен"/>
                        <ComboBoxItem Content="Неактивен"/>
                    </ComboBox>

                    <TextBlock Text="Роль*" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cmbRole" DisplayMemberPath="RoleName" SelectedValuePath="RoleID" SelectionChanged="CmbRole_SelectionChanged" Margin="0,0,0,40" Height="70" VerticalContentAlignment="Center"/>

                    <Button Content="Зарегистрировать" Click="BtnRegister_Click" Width="280" Margin="0,10" HorizontalAlignment="Center" Height="60" FontSize="16" FontWeight="Bold"/>
                    <Button Content="Уже есть аккаунт? Войти" Click="BtnGoToLogin_Click" Width="280" Margin="0,10" HorizontalAlignment="Center" Background="Transparent" Foreground="{StaticResource PrimaryColor}" Height="50" BorderThickness="0"/>

                    <TextBlock x:Name="lblMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource ErrorColor}" FontWeight="SemiBold" FontSize="14" Margin="0,20,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>