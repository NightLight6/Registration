<Page x:Class="Registration.Pages.RegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Регистрация нового пользователя"
      Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Регистрация нового пользователя" 
                   FontSize="18" 
                   HorizontalAlignment="Center" 
                   Margin="0,20,0,10"
                   FontWeight="Bold"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel HorizontalAlignment="Center" 
                        VerticalAlignment="Top"
                        Width="300"
                        Margin="0,0,0,20">
                <TextBlock Text="Фамилия*" />
                <TextBox x:Name="txtSurname" Margin="0,0,0,5"/>

                <TextBlock Text="Имя*" />
                <TextBox x:Name="txtName" Margin="0,0,0,5"/>

                <TextBlock Text="Отчество" />
                <TextBox x:Name="txtOtchestvo" Margin="0,0,0,5"/>

                <TextBlock Text="Логин*" />
                <TextBox x:Name="txtLogin" Margin="0,0,0,5"/>

                <TextBlock Text="Email" />
                <TextBox x:Name="txtEmail" Margin="0,0,0,5"/>

                <TextBlock Text="Телефон" />
                <TextBox x:Name="txtPhone" Margin="0,0,0,5"/>

                <TextBlock Text="Должность" />
                <TextBox x:Name="txtPosition" Margin="0,0,0,5"/>

                <TextBlock Text="Пароль*" />
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,5"/>

                <TextBlock Text="Статус" />
                <ComboBox x:Name="cmbStatus" SelectedIndex="0" Margin="0,0,0,5">
                    <ComboBoxItem Content="Активен"/>
                    <ComboBoxItem Content="Неактивен"/>
                </ComboBox>

                <TextBlock Text="Роль*" />
                <ComboBox x:Name="cmbRole"
                          DisplayMemberPath="RoleName"
                          SelectedValuePath="RoleID"
                          SelectionChanged="CmbRole_SelectionChanged"
                          Margin="0,0,0,5"/>

                <Button Content="Зарегистрировать" Click="BtnRegister_Click" Width="180" Margin="5" Background="#9400D3" Foreground="White" Padding="10,5"/>

                <Button Content="Уже есть аккаунт? Войти" 
                        Click="BtnGoToLogin_Click" Width="200" Margin="5" Background="#9400D3" Foreground="White" Padding="10,5"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" 
                Background="#FFF0F0" 
                BorderBrush="Red" 
                BorderThickness="0,1,0,0" 
                Padding="10"
                Visibility="Collapsed"
                x:Name="errorPanel">
            <TextBlock x:Name="lblMessage" 
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       Foreground="Red"
                       FontWeight="Bold"/>
        </Border>
    </Grid>
</Page>