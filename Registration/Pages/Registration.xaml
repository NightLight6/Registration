<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="Registration.Pages.RegistrationPage"
    Title="Регистрация нового пользователя"
    Background="White" 
    av:DesignHeight="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Регистрация нового пользователя" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,20,0,10"
                       FontWeight="Bold"/>

            <StackPanel Grid.Row="1" 
                        HorizontalAlignment="Center" 
                        VerticalAlignment="Top"
                        Width="300"
                        Margin="0,0,0,20">

                <TextBlock Text="Фамилия*" />
                <TextBox x:Name="txtSurname" Margin="0,0,0,5"/>

                <TextBlock Text="Имя*" />
                <TextBox x:Name="txtName" Margin="0,0,0,5"/>

                <TextBlock Text="Отчество" />
                <TextBox x:Name="txtOtchestvo" Margin="0,0,0,5"/>

                <TextBlock Text="Логин*" />
                <TextBox x:Name="txtLogin" Margin="0,0,0,5"/>

                <TextBlock Text="Email" />
                <TextBox x:Name="txtEmail" Margin="0,0,0,5"/>

                <TextBlock Text="Телефон" />
                <TextBox x:Name="txtPhone" Margin="0,0,0,5"/>

                <TextBlock Text="Должность" />
                <TextBox x:Name="txtPosition" Margin="0,0,0,5"/>

                <TextBlock Text="Пароль*" />
                <PasswordBox x:Name="txtPassword" Margin="0,0,0,5"/>

                <TextBlock Text="Статус" />
                <ComboBox x:Name="cmbStatus" SelectedIndex="0" Margin="0,0,0,5">
                    <ComboBoxItem Content="Активен"/>
                    <ComboBoxItem Content="Неактивен"/>
                </ComboBox>

                <TextBlock Text="Роль*" />
                <ComboBox x:Name="cmbRole"
                          DisplayMemberPath="RoleName"
                          SelectedValuePath="RoleID"
                          SelectionChanged="CmbRole_SelectionChanged"
                          Margin="0,0,0,5"/>

                <Button Content="Зарегистрировать" 
                        Click="BtnRegister_Click" 
                        Width="180" Margin="5" 
                        Background="#9400D3" Foreground="White" Padding="10,5"/>

                <Button Content="Уже есть аккаунт? Войти"   Click="BtnGoToLogin_Click"   Width="204" Margin="5"  Background="#9400D3" Foreground="White" Padding="10,5"/>

                <TextBlock x:Name="lblMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="Red" FontWeight="Bold" Margin="0,10,0,0"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>