<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="Registration.Pages.RegistrationPage"
    Title="Регистрация нового пользователя"
    Background="{StaticResource DarkBackground}" 
    av:DesignHeight="950">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <Border Grid.Row="0" 
                    Background="{StaticResource DarkSurface}" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="0,0,0,1" 
                    Padding="30,25">
                <TextBlock Text="Регистрация нового пользователя" 
                           FontSize="28" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center" 
                           Foreground="{StaticResource TextPrimary}"/>
            </Border>

            <!-- Форма регистрации -->
            <Border Grid.Row="1" 
                    Margin="30" 
                    Background="{StaticResource DarkSurface}" 
                    CornerRadius="16" 
                    Padding="40" 
                    BorderBrush="{StaticResource BorderColor}" 
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.3" Color="Black"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="500" HorizontalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Фамилия -->
                            <TextBlock Text="Фамилия*" 
                                       Grid.Row="0" 
                                       Grid.Column="0" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,0,10,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtSurname" 
                                     Grid.Row="1" 
                                     Grid.Column="0" 
                                     Margin="0,0,10,26" Grid.RowSpan="2"/>

                            <!-- Имя -->
                            <TextBlock Text="Имя*" 
                                       Grid.Row="0" 
                                       Grid.Column="1" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="10,0,0,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtName" 
                                     Grid.Row="1" 
                                     Grid.Column="1" 
                                     Margin="10,0,0,5"/>

                            <!-- Отчество -->
                            <TextBlock Text="Отчество" 
                                       Grid.Row="2" 
                                       Grid.ColumnSpan="2" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,0,0,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtOtchestvo" 
                                     Grid.Row="3" 
                                     Grid.ColumnSpan="2" 
                                     Margin="0,0,0,5"/>

                            <!-- Логин -->
                            <TextBlock Text="Логин*" 
                                       Grid.Row="4" 
                                       Grid.ColumnSpan="2" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,0,0,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtLogin" 
                                     Grid.Row="4" 
                                     Grid.ColumnSpan="2" 
                                     Margin="0,27,0,10" Grid.RowSpan="2"/>

                            <!-- Email -->
                            <TextBlock Text="Email" 
                                       Grid.Row="6" 
                                       Grid.ColumnSpan="2" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,0,0,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtEmail" 
                                     Grid.Row="7" 
                                     Grid.ColumnSpan="2" 
                                     Margin="0,0,0,10"/>

                            <!-- Телефон -->
                            <TextBlock Text="Телефон" 
                                       Grid.Row="8" 
                                       Grid.Column="0" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="0,0,10,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtPhone" 
                                     Grid.Row="9" 
                                     Grid.Column="0" 
                                     Margin="0,1,10,10"/>

                            <!-- Должность -->
                            <TextBlock Text="Должность" 
                                       Grid.Row="8" 
                                       Grid.Column="1" 
                                       Foreground="{StaticResource TextSecondary}" 
                                       Margin="10,0,0,8" 
                                       FontWeight="SemiBold"/>
                            <TextBox x:Name="txtPosition" 
                                     Grid.Row="9" 
                                     Grid.Column="1" 
                                     Margin="10,0,0,10"/>
                        </Grid>

                        <!-- Пароль -->
                        <TextBlock Text="Пароль*" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="0,0,0,8" 
                                   FontWeight="SemiBold"/>
                        <PasswordBox x:Name="txtPassword" 
                                     Margin="0,0,0,20" 
                                     Height="48"/>

                        <!-- Статус -->
                        <TextBlock Text="Статус" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="0,0,0,8" 
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbStatus" 
                                  SelectedIndex="0" 
                                  Margin="0,0,0,20" 
                                  Height="48">
                            <ComboBoxItem Content="Активен"/>
                            <ComboBoxItem Content="Неактивен"/>
                        </ComboBox>

                        <!-- Роль -->
                        <TextBlock Text="Роль*" 
                                   Foreground="{StaticResource TextSecondary}" 
                                   Margin="0,0,0,8" 
                                   FontWeight="SemiBold"/>
                        <ComboBox x:Name="cmbRole"
                                  DisplayMemberPath="RoleName"
                                  SelectedValuePath="RoleID"
                                  SelectionChanged="CmbRole_SelectionChanged"
                                  Margin="0,0,0,30"
                                  Height="48"/>

                        <!-- Кнопки -->
                        <Button Content="Зарегистрировать" 
                                Click="BtnRegister_Click" 
                                Width="220" 
                                Margin="0,10" 
                                HorizontalAlignment="Center"
                                Height="52"
                                FontSize="15"
                                Padding="20,12"/>

                        <Button Content="Уже есть аккаунт? Войти"   
                                Click="BtnGoToLogin_Click"   
                                Width="220" 
                                Margin="0,10"  
                                HorizontalAlignment="Center"
                                Background="Transparent"
                                Foreground="{StaticResource PrimaryColor}"
                                Height="48"
                                Padding="20,10"/>

                        <!-- Сообщение -->
                        <TextBlock x:Name="lblMessage" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center" 
                                   Foreground="{StaticResource ErrorColor}" 
                                   FontWeight="SemiBold" 
                                   FontSize="13"
                                   Margin="0,20,0,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
