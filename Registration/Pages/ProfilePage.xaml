<Page x:Class="Registration.Pages.ProfilePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Личный кабинет" Background="{StaticResource DarkBackground}" Height="700" Width="900">
    <Grid Margin="30">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource DarkSurface}" CornerRadius="20" Padding="20" Margin="0,0,20,0">
            <StackPanel>
                <Ellipse Width="120" Height="120" Fill="{StaticResource PrimaryColor}" Margin="0,0,0,20">
                </Ellipse>
                <TextBlock x:Name="tblFullName" Text="Имя Фамилия" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock x:Name="tblRole" Text="Пользователь" FontSize="14" Foreground="{StaticResource PrimaryColor}" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <Separator Background="{StaticResource BorderColor}" Margin="0,10"/>

                <StackPanel Margin="0,10">
                    <TextBlock Text="Логин:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="tblLogin" Text="user123" Foreground="White" FontSize="16" Margin="0,0,0,10"/>

                    <TextBlock Text="Email:" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                    <TextBlock x:Name="tblEmail" Text="email@test.com" Foreground="White" FontSize="16"/>
                </StackPanel>

                <Button Content="Выйти из аккаунта" Click="BtnLogout_Click" Margin="0,30,0,0" Background="#33FF4B4B" Foreground="#FFFF4B4B" BorderBrush="#FFFF4B4B" Height="48" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Безопасность" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>

                <Border Background="{StaticResource DarkSurface}" CornerRadius="15" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Двухфакторная аутентификация (2FA)" FontSize="16" Foreground="White" FontWeight="SemiBold"/>
                                <TextBlock Text="Дополнительный код подтверждения при входе через почту" FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="cbTwoFactorEnable" HorizontalAlignment="Right" VerticalAlignment="Center" 
                                      Style="{StaticResource {x:Type CheckBox}}" 
                                      Checked="CbTwoFactor_Changed" Unchecked="CbTwoFactor_Changed" Cursor="Hand">
                                <CheckBox.LayoutTransform>
                                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                                </CheckBox.LayoutTransform>
                            </CheckBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource DarkSurface}" CornerRadius="15" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Изменить пароль" FontSize="18" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="Новый пароль" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="pbNewPass" Height="50" Margin="0,0,0,15"/>

                        <TextBlock Text="Подтвердите пароль" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,5"/>
                        <PasswordBox x:Name="pbConfirmPass" Height="50" Margin="0,0,0,15"/>

                        <Button Content="Обновить пароль" Click="BtnUpdatePassword_Click" Background="{StaticResource PrimaryColor}" Foreground="White" Width="180" Height="48" HorizontalAlignment="Left"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>