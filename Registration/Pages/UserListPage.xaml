<Page x:Class="Registration.Pages.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Services"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список сотрудников"
      Background="{StaticResource DarkBackground}">

    <Page.Resources>
        <local:ImagePathToImageSourceConverter x:Key="PhotoConverter"/>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтров -->
        <Border Grid.Row="0" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,20"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поиск:" 
                           Grid.Column="0"
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" 
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <Border Grid.Column="1" 
                        Background="{StaticResource DarkCard}" 
                        CornerRadius="8" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1"
                        Height="42">
                    <TextBox Name="txtSearch" 
                             Margin="12,0,12,-15" 
                             KeyUp="txtSearch_KeyUp"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalContentAlignment="Center"
                             FontSize="14"/>
                </Border>

                <TextBlock Text="Роль:" 
                           Grid.Column="2"
                           VerticalAlignment="Center" 
                           Margin="20,0,12,0" 
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="SemiBold"
                           FontSize="14"/>
                <ComboBox Name="cmbRolesFilter" 
                          Grid.Column="3"
                          Width="200" 
                          Margin="0,11,12,0" 
                          SelectionChanged="cmbRolesFilter_SelectionChanged">
                    <ComboBoxItem Content="Все роли" Tag="-1" IsSelected="True"/>
                </ComboBox>

                <Button Content="+ Добавить" 
                        Grid.Column="4"
                        Click="btnAdd_Click" 
                        Padding="18,10" 
                        Width="150"
                        FontSize="14"
                        FontWeight="Bold" Margin="5,5,5,0"/>
            </Grid>
        </Border>

        <!-- Таблица пользователей -->
        <Border Grid.Row="1" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1"
                Padding="5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <ListView Name="lvUsers" 
                      Background="Transparent"
                      MouseDoubleClick="lvUsers_MouseDoubleClick"
                      SelectionChanged="lvUsers_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Фото" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Width="60" 
                                            Height="60" 
                                            CornerRadius="8" 
                                            Background="{StaticResource DarkCard}"
                                            BorderBrush="{StaticResource BorderColor}"
                                            BorderThickness="1"
                                            Margin="5">
                                        <Image Width="55" 
                                               Height="55" 
                                               Stretch="UniformToFill">
                                            <Image.Source>
                                                <MultiBinding Converter="{StaticResource PhotoConverter}">
                                                    <Binding Path="PhotoPath"/>
                                                    <Binding Source="{x:Static Application.Current}"/>
                                                </MultiBinding>
                                            </Image.Source>
                                        </Image>
                                    </Border>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserID}" Width="70"/>
                        <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="140"/>
                        <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="140"/>
                        <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Surname}" Width="140"/>
                        <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding Roles.RoleName}" Width="170"/>
                        <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding Position}" Width="170"/>
                        <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="200"/>
                        <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding Phone}" Width="140"/>
                        <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="120"/>
                    </GridView>
                </ListView.View>

                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Редактировать" Click="MenuItem_Edit_Click"/>
                        <MenuItem Header="Удалить" Click="MenuItem_Delete_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>
            </ListView>
        </Border>
    </Grid>
</Page>
