<Page x:Class="Registration.Pages.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Services"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список сотрудников">

    <Page.Resources>
        <local:PhotoPathToImageSourceConverter x:Key="PhotoConverter"/>
    </Page.Resources>

    <!-- Основной контейнер -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Панель поиска и фильтрации -->
            <RowDefinition Height="*"/>
            <!-- Список сотрудников -->
        </Grid.RowDefinitions>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBox Name="txtSearch" Width="200" Margin="0,0,10,0" KeyUp="txtSearch_KeyUp"/>

            <TextBlock Text="Роль:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox Name="cmbRolesFilter" Width="150" Margin="0,0,10,0" SelectionChanged="cmbRolesFilter_SelectionChanged">
                <ComboBoxItem Content="Все роли" Tag="-1" IsSelected="True"/>
            </ComboBox>

            <Button Content="Добавить" Click="btnAdd_Click" Margin="10,0" Background="#9400D3" Foreground="White" Padding="10,5"/>
        </StackPanel>

        <!-- Список сотрудников -->
        <ListView Name="lvUsers" Grid.Row="1" Margin="0">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Фото" Width="60">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Width="40" Height="40" Stretch="UniformToFill">
                                    <Image.Source>
                                        <MultiBinding Converter="{StaticResource PhotoConverter}">
                                            <Binding Path="PhotoPath"/>
                                            <Binding Source="{x:Static Application.Current}"/>
                                        </MultiBinding>
                                    </Image.Source>
                                </Image>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserID}" Width="50"/>
                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="120"/>
                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="120"/>
                    <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Surname}" Width="120"/>
                    <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding Roles.RoleName}" Width="150"/>
                    <GridViewColumn Header="Должность" DisplayMemberBinding="{Binding Position}" Width="150"/>
                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="150"/>
                    <GridViewColumn Header="Телефон" DisplayMemberBinding="{Binding Phone}" Width="120"/>
                    <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding Status}" Width="100"/>
                </GridView>
            </ListView.View>

            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Редактировать" Click="MenuItem_Edit_Click"/>
                    <MenuItem Header="Удалить" Click="MenuItem_Delete_Click"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</Page>