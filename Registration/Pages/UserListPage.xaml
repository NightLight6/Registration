<Page x:Class="Registration.Pages.UserListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Services"
      xmlns:models="clr-namespace:Registration.Model"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Список сотрудников"
      Background="{StaticResource DarkBackground}">

    <Page.Resources>
        <local:ImagePathToImageSourceConverter x:Key="PhotoConverter"/>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,20"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Поиск:" 
                           Grid.Column="0"
                           VerticalAlignment="Center" 
                           Margin="0,0,12,0" 
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <Border Grid.Column="1" 
                        Background="{StaticResource DarkCard}" 
                        CornerRadius="8" 
                        BorderBrush="{StaticResource BorderColor}" 
                        BorderThickness="1"
                        Height="42">
                    <TextBox Name="txtSearch" 
                             Margin="10,0" 
                             KeyUp="txtSearch_KeyUp"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="{StaticResource TextPrimary}"
                             VerticalContentAlignment="Center"
                             FontSize="14"/>
                </Border>

                <TextBlock Text="Роль:" 
                           Grid.Column="2"
                           VerticalAlignment="Center" 
                           Margin="20,0,12,0" 
                           Foreground="{StaticResource TextSecondary}"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <ComboBox Name="cmbRolesFilter" 
                          Grid.Column="3"
                          Width="200" 
                          VerticalAlignment="Center"
                          SelectionChanged="cmbRolesFilter_SelectionChanged">
                    <ComboBoxItem Content="Все роли" Tag="-1" IsSelected="True"/>
                </ComboBox>

                <Button Content="+ Добавить" 
                        Grid.Column="4"
                        Click="btnAdd_Click" 
                        Padding="18,10" 
                        Width="150"
                        Margin="20,0,0,0"
                        FontSize="14"
                        FontWeight="Bold"/>
                
                <Button Content="Печать списка" 
                Grid.Column="5" 
                Click="PrintListButton_Click" 
                Padding="18,10" 
                Width="150" 
                Margin="10,0,0,0" 
                FontSize="14" 
                FontWeight="Bold"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" 
        Background="{StaticResource DarkSurface}" 
        CornerRadius="12" 
        BorderBrush="{StaticResource BorderColor}" 
        BorderThickness="1" 
        Padding="5">

            <FlowDocumentReader x:Name="flowDocumentReader" ViewingMode="Scroll">
                <FlowDocument PageWidth="Auto">
                    <BlockUIContainer>
                        <ListView Name="lvUsers" 
                          Background="Transparent"
                          BorderThickness="0"
                          MouseDoubleClick="lvUsers_MouseDoubleClick">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding UserID}" Width="50"/>
                                    <GridViewColumn Header="Логин" DisplayMemberBinding="{Binding Login}" Width="120"/>
                                    <GridViewColumn Header="Имя" DisplayMemberBinding="{Binding Name}" Width="120"/>
                                    <GridViewColumn Header="Фамилия" DisplayMemberBinding="{Binding Surname}" Width="120"/>
                                    <GridViewColumn Header="Роль" DisplayMemberBinding="{Binding Roles.RoleName}" Width="150"/>
                                    <GridViewColumn Header="Email" DisplayMemberBinding="{Binding Email}" Width="180"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </BlockUIContainer>
                </FlowDocument>
            </FlowDocumentReader>
        </Border>
    </Grid>
</Page>