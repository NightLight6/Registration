<Page x:Class="Registration.Pages.EmploymentContractPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Services"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1000"
      Title="Формирование трудового договора"
      Background="{StaticResource DarkBackground}">

    <Page.Resources>
        <local:ImagePathToImageSourceConverter x:Key="PhotoConverter"/>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="20" 
                Margin="0,0,0,20"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="ФОРМИРОВАНИЕ ТРУДОВОГО ДОГОВОРА" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,0,0,5"/>
                <TextBlock Name="EmployeeHeaderBlock"
                           FontSize="14" 
                           Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="20"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{StaticResource DarkCard}" 
                            CornerRadius="8" 
                            Padding="15"
                            Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="ФИО сотрудника:" 
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBlock Name="EmployeeNameTextBlock" 
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="5,0,5,0">
                                <TextBlock Text="Должность:" 
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBlock Name="EmployeePositionTextBlock" 
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                <TextBlock Text="Отдел:" 
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBlock Name="DepartmentNameTextBlock" 
                                           Foreground="{StaticResource TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Text="ДАННЫЕ ДЛЯ ДОГОВОРА" 
                               Grid.Row="1"
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}"
                               Margin="0,0,0,15"/>

                    <Grid Grid.Row="2" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,15">
                            <TextBlock Text="Номер договора *" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="ContractNumberTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,15">
                            <TextBlock Text="Город *" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="CityTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"
                                     Text="Новосибирск"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,15">
                            <TextBlock Text="Дата заключения (ДД.ММ.ГГГГ) *" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="ContractDateTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,15">
                            <TextBlock Text="Испытательный срок (мес.)" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="TestPeriodTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"
                                     Text="3"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,15">
                            <TextBlock Text="Заработная плата (руб.) *" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="SalaryTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"/>
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,15">
                            <TextBlock Text="Дата начала работы (ДД.ММ.ГГГГ) *" 
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <TextBox Name="StartDateTextBox" 
                                     Height="40"
                                     Padding="10,0"
                                     Background="{StaticResource DarkCard}"
                                     BorderBrush="{StaticResource BorderColor}"
                                     BorderThickness="1"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontSize="14"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="3" 
                            Background="{StaticResource DarkCard}" 
                            CornerRadius="8" 
                            Padding="15"
                            Margin="0,0,0,20"
                            BorderBrush="{StaticResource BorderColor}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="ДАННЫЕ РАБОТОДАТЕЛЯ" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource TextPrimary}"
                                       Margin="0,0,0,15"/>

                            <StackPanel Margin="0,0,0,15">
                                <TextBlock Text="Наименование организации *" 
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBox Name="EmployerNameTextBox" 
                                         Height="40"
                                         Padding="10,0"
                                         Background="{StaticResource DarkSurface}"
                                         BorderBrush="{StaticResource BorderColor}"
                                         BorderThickness="1"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="14"
                                         Text="ООО &quot;BEERMAGE&quot;"/>
                            </StackPanel>

                            <StackPanel>
                                <TextBlock Text="Генеральный директор *" 
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="12"
                                           Margin="0,0,0,5"/>
                                <TextBox Name="DirectorNameTextBox" 
                                         Height="40"
                                         Padding="10,0"
                                         Background="{StaticResource DarkSurface}"
                                         BorderBrush="{StaticResource BorderColor}"
                                         BorderThickness="1"
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="14"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="0,20,0,0">
            <Button Content="← Назад" 
                    Click="CancelButton_Click"
                    Padding="25,12" 
                    Width="150"
                    Margin="0,0,15,0"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="{StaticResource DarkCard}"
                    Foreground="{StaticResource TextPrimary}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    Cursor="Hand"/>

            <Button Content="📄 Сформировать договор" 
                    Click="CreateContractButton_Click"
                    Padding="25,12" 
                    Width="220"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Background="{StaticResource SuccessColor}"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Page>