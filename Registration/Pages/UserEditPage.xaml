<Page x:Class="Registration.Pages.UserEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Редактирование сотрудника">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Блок с фото -->
            <RowDefinition Height="*"/>
            <!-- Основная форма -->
        </Grid.RowDefinitions>

        <!-- Блок с выбором фото -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Выбрать фото" Click="btnSelectPhoto_Click" Margin="0,0,10,0" Background="#9400D3" Foreground="White" Padding="10,5" Width="152"/>
            <Image x:Name="imgPhoto" Width="100" Height="100" Stretch="UniformToFill" Margin="0,0,10,0"/>
            <TextBlock x:Name="lblPlaceholder" Text="Нет фото" VerticalAlignment="Center" Foreground="Gray" FontSize="14"/>
        </StackPanel>

        <!-- Основная форма -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Логин*" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtLogin" Grid.Row="0" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Имя*" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Фамилия*" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtSurname" Grid.Row="2" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Отчество" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtOtchestvo" Grid.Row="3" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Email*" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Телефон" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtPhone" Grid.Row="5" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Должность" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox x:Name="txtPosition" Grid.Row="6" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Роль*" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox x:Name="cmbRoles" Grid.Row="7" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Статус" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox x:Name="cmbStatus" Grid.Row="8" Grid.Column="1" Margin="5">
                    <ComboBoxItem Content="Активен"/>
                    <ComboBoxItem Content="Неактивен"/>
                </ComboBox>

                <TextBlock Text="Пароль*" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <PasswordBox x:Name="pbPassword" Grid.Row="9" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Подтверждение*" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
                <PasswordBox x:Name="pbConfirm" Grid.Row="10" Grid.Column="1" Margin="5"/>

                <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15">
                    <Button Content="Сохранить" Click="btnSave_Click" Width="108" Margin="5" Background="#9400D3" Foreground="White" Padding="10,5"/>
                    <Button Content="Очистить" Click="btnClear_Click" Width="100" Margin="5" Background="#9400D3" Foreground="White" Padding="10,5"/>
                    <Button Content="Назад" Click="btnBack_Click" Width="100" Margin="5" Background="#9400D3" Foreground="White" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>