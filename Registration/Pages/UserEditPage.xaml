<Page x:Class="Registration.Pages.UserEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Registration.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Редактирование сотрудника"
      Background="{StaticResource DarkBackground}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок с фото -->
        <Border Grid.Row="0" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="25" 
                Margin="0,0,0,25"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Фото пользователя -->
                <Border Grid.Column="0" 
                        Width="120" 
                        Height="120" 
                        CornerRadius="12" 
                        Background="{StaticResource DarkCard}"
                        BorderBrush="{StaticResource BorderColor}"
                        BorderThickness="2"
                        Margin="0,0,25,0">
                    <Grid>
                        <Image x:Name="imgPhoto" 
                               Width="116" 
                               Height="116" 
                               Stretch="UniformToFill"
                               ClipToBounds="True">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,116,116" RadiusX="10" RadiusY="10"/>
                            </Image.Clip>
                        </Image>
                        <TextBlock x:Name="lblPlaceholder" 
                                   Text="Нет фото" 
                                   VerticalAlignment="Center" 
                                   HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextSecondary}" 
                                   FontSize="14"
                                   Visibility="Visible"/>
                    </Grid>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="📷 Выбрать фото" 
                            Click="btnSelectPhoto_Click" 
                            Padding="16,10" 
                            Width="180"
                            Height="51"
                            FontSize="14"
                            Margin="0,0,0,10"/>
                    <TextBlock Text="Рекомендуемый размер: 200x200px" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Форма редактирования -->
        <Border Grid.Row="1" 
                Background="{StaticResource DarkSurface}" 
                CornerRadius="12" 
                Padding="30"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="15" ShadowDepth="2" Opacity="0.2" Color="Black"/>
            </Border.Effect>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Логин*" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtLogin" Grid.Row="0" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Имя*" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtName" Grid.Row="1" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Фамилия*" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtSurname" Grid.Row="2" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Отчество" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtOtchestvo" Grid.Row="3" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Email*" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtEmail" Grid.Row="4" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Телефон" Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtPhone" Grid.Row="5" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Должность" Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <TextBox x:Name="txtPosition" Grid.Row="6" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Роль*" Grid.Row="7" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <ComboBox x:Name="cmbRoles" Grid.Row="7" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Статус" Grid.Row="8" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <ComboBox x:Name="cmbStatus" Grid.Row="8" Grid.Column="1" Margin="10,8" Height="46">
                        <ComboBoxItem Content="Активен"/>
                        <ComboBoxItem Content="Неактивен"/>
                    </ComboBox>

                    <TextBlock Text="Пароль*" Grid.Row="9" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <PasswordBox x:Name="pbPassword" Grid.Row="9" Grid.Column="1" Margin="10,8" Height="46"/>

                    <TextBlock Text="Подтверждение*" Grid.Row="10" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" FontSize="14"/>
                    <PasswordBox x:Name="pbConfirm" Grid.Row="10" Grid.Column="1" Margin="10,8" Height="46"/>

                    <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
                        <Button Content="💾 Сохранить" Click="btnSave_Click" Width="140" Margin="8" Padding="18,12" Height="48" FontSize="14" FontWeight="Bold"/>
                        <Button Content="🔄 Очистить" Click="btnClear_Click" Width="130" Margin="8" Padding="18,12" Height="48" FontSize="14"/>
                        <Button Content="← Назад" Click="btnBack_Click" Width="120" Margin="8" Padding="18,12" Height="48" FontSize="14" Background="{StaticResource DarkCard}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
