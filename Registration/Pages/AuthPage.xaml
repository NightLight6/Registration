<Page x:Class="Registration.Pages.AuthPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация" Background="{StaticResource DarkBackground}" Width="900" Height="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Декоративный градиентный фон -->
        <Rectangle Grid.ColumnSpan="3" Opacity="0.05">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        
        <Border Grid.Column="1" 
                Background="{StaticResource DarkSurface}" 
                BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" 
                CornerRadius="16" 
                Margin="20" 
                Padding="40" 
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.4" Color="Black"/>
            </Border.Effect>
            <StackPanel VerticalAlignment="Center">
                <!-- Заголовок -->
                <TextBlock Text="Авторизация" 
                           FontSize="36" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource TextPrimary}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,40"/>
                
                <!-- Основная форма авторизации -->
                <StackPanel x:Name="spMainAuth" Visibility="Visible">
                    <TextBlock Text="Логин" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,0,0,8" 
                               FontWeight="SemiBold"/>
                    <Border x:Name="bdrLogin" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="50" 
                            Margin="0,0,0,15">
                        <TextBox x:Name="tbLogin" 
                                 Padding="15,0" 
                                 FontSize="15" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    
                    <TextBlock Text="Пароль" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,15,0,8" 
                               FontWeight="SemiBold"/>
                    <Border x:Name="bdrPassword" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="50" 
                            Margin="0,0,0,15">
                        <PasswordBox x:Name="tbPassword" 
                                     Padding="15,0" 
                                     FontSize="15" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                    
                    <!-- Капча -->
                    <Border x:Name="brCaptcha" 
                            Visibility="Collapsed" 
                            Background="{StaticResource WarningColor}" 
                            Opacity="0.15" 
                            CornerRadius="10" 
                            Padding="18" 
                            Margin="0,15,0,0" 
                            BorderBrush="{StaticResource WarningColor}" 
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Введите код с картинки" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource WarningColor}" 
                                       Margin="0,0,0,12" 
                                       FontSize="14"/>
                            <TextBlock x:Name="tblCaptcha" 
                                       Text="КАПЧА" 
                                       FontSize="28" 
                                       FontWeight="Bold" 
                                       FontFamily="Courier New" 
                                       Foreground="{StaticResource WarningColor}" 
                                       TextDecorations="Strikethrough" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,12"/>
                            <Border Background="{StaticResource DarkCard}" 
                                    BorderBrush="{StaticResource WarningColor}" 
                                    BorderThickness="2" 
                                    CornerRadius="8" 
                                    Height="42" 
                                    Margin="0,0,0,5">
                                <TextBox x:Name="tbCaptcha" 
                                         Padding="12,0" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Foreground="{StaticResource TextPrimary}"
                                         FontSize="16"
                                         VerticalContentAlignment="Center"/>
                            </Border>
                        </StackPanel>
                    </Border>
                    
                    <TextBlock x:Name="tbBlockTimer" 
                               Visibility="Collapsed" 
                               Foreground="{StaticResource ErrorColor}" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,20,0,0" 
                               FontSize="15"/>
                    
                    <!-- Кнопки входа -->
                    <Grid Margin="0,30,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnEnterGuest" 
                                Grid.Column="0" 
                                Content="Войти как гость" 
                                Height="50" 
                                Background="{StaticResource DarkCard}" 
                                Foreground="{StaticResource TextPrimary}" 
                                BorderBrush="{StaticResource BorderColor}" 
                                BorderThickness="1" 
                                FontSize="14" 
                                Cursor="Hand" 
                                Click="btnEnterGuest_Click"/>
                        <Button x:Name="btnEnter" 
                                Grid.Column="2" 
                                Content="Войти" 
                                Height="50" 
                                Background="{StaticResource PrimaryColor}" 
                                Foreground="White" 
                                BorderThickness="0" 
                                FontSize="15" 
                                FontWeight="Bold" 
                                Cursor="Hand" 
                                Click="btnEnter_Click"/>
                    </Grid>
                    
                    <Button x:Name="BtnForgotPassword" 
                            Content="Забыли пароль?" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource PrimaryColor}" 
                            FontSize="14" 
                            Cursor="Hand" 
                            HorizontalAlignment="Center" 
                            Margin="0,10,0,8" 
                            Click="BtnForgotPassword_Click"
                            Padding="10,5"/>
                    <Button x:Name="btnGoToRegister" 
                            Content="Нет аккаунта? Зарегистрироваться" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource PrimaryColor}" 
                            FontSize="14" 
                            Cursor="Hand" 
                            HorizontalAlignment="Center" 
                            Margin="0,0,0,10" 
                            Click="BtnGoToRegister_Click"
                            Padding="10,5"/>
                </StackPanel>
                
                <!-- Восстановление пароля - Email -->
                <StackPanel x:Name="spForgotPasswordEmail" Visibility="Collapsed" Margin="0,0,0,20">
                    <Button Content="← Назад к авторизации" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource TextSecondary}" 
                            FontSize="13" 
                            HorizontalAlignment="Left" 
                            Cursor="Hand" 
                            Margin="0,0,0,25" 
                            Click="BackToAuth_Click"
                            Padding="0"/>
                    <TextBlock Text="🔑 Восстановление пароля" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                    <Border Background="{StaticResource PrimaryColor}" 
                            Opacity="0.15" 
                            CornerRadius="10" 
                            Padding="18" 
                            Margin="0,0,0,25" 
                            BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="1">
                        <TextBlock Text="Мы отправим 4-значный код на ваш email" 
                                   Foreground="{StaticResource PrimaryColor}" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Email" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,0,0,8" 
                               FontWeight="SemiBold"/>
                    <Border x:Name="bdrRecoveryEmail" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="50" 
                            Margin="0,0,0,8">
                        <TextBox x:Name="tbRecoveryEmail" 
                                 Padding="15,0" 
                                 FontSize="15" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button x:Name="btnSendRecoveryCode" 
                            Content="Отправить код" 
                            Height="50" 
                            Background="{StaticResource PrimaryColor}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,30,0,0" 
                            Click="BtnSendRecoveryCode_Click"/>
                </StackPanel>
                
                <!-- Восстановление пароля - Код -->
                <StackPanel x:Name="spRecoveryCode" Visibility="Collapsed" Margin="0,0,0,20">
                    <Button Content="← Назад" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource TextSecondary}" 
                            FontSize="13" 
                            HorizontalAlignment="Left" 
                            Cursor="Hand" 
                            Margin="0,0,0,25" 
                            Click="BackToEmail_Click"
                            Padding="0"/>
                    <TextBlock Text="Подтверждение кода" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="tbRecoveryEmailDisplay" 
                               Foreground="{StaticResource PrimaryColor}" 
                               FontSize="15" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                    <Border Background="{StaticResource SuccessColor}" 
                            Opacity="0.15" 
                            CornerRadius="10" 
                            Padding="18" 
                            Margin="0,0,0,25" 
                            BorderBrush="{StaticResource SuccessColor}" 
                            BorderThickness="1">
                        <TextBlock x:Name="tbCodeInstructions" 
                                   Text="Введите код, отправленный на ваш email" 
                                   Foreground="{StaticResource SuccessColor}" 
                                   FontSize="14" 
                                   TextWrapping="Wrap" 
                                   FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock Text="Код из письма" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,0,0,10" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <Border x:Name="bdrRecoveryCode" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource SuccessColor}" 
                            BorderThickness="2" 
                            CornerRadius="12" 
                            Height="60" 
                            Margin="0,0,0,10" 
                            HorizontalAlignment="Center" 
                            Width="180">
                        <TextBox x:Name="tbRecoveryCode" 
                                 Padding="10,0" 
                                 FontSize="24" 
                                 FontWeight="Bold" 
                                 MaxLength="4" 
                                 CharacterCasing="Upper" 
                                 TextAlignment="Center" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Content="Подтвердить код" 
                            Height="50" 
                            Background="{StaticResource SuccessColor}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,30,0,0" 
                            Click="BtnConfirmRecoveryCode_Click"/>
                    <Button Content="Отправить код повторно" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource PrimaryColor}" 
                            FontSize="13" 
                            Cursor="Hand" 
                            Margin="0,18,0,0" 
                            Click="BtnSendRecoveryCode_Click"
                            Padding="10,5"/>
                </StackPanel>
                
                <!-- Новый пароль -->
                <StackPanel x:Name="spNewPassword" Visibility="Collapsed" Margin="0,0,0,20">
                    <Button Content="Назад" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Foreground="{StaticResource TextSecondary}" 
                            FontSize="13" 
                            HorizontalAlignment="Left" 
                            Cursor="Hand" 
                            Margin="0,0,0,25" 
                            Click="BackToCode_Click"
                            Padding="0"/>
                    <TextBlock Text="Новый пароль" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                    <TextBlock Text="Новый пароль" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,0,0,8" 
                               FontWeight="SemiBold"/>
                    <Border x:Name="bdrNewPassword" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="50" 
                            Margin="0,0,0,8">
                        <PasswordBox x:Name="pbNewPassword" 
                                     Padding="15,0" 
                                     FontSize="15" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Повторите пароль" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,18,0,8" 
                               FontWeight="SemiBold"/>
                    <Border x:Name="bdrConfirmPassword" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource BorderColor}" 
                            BorderThickness="1" 
                            CornerRadius="10" 
                            Height="50" 
                            Margin="0,0,0,8">
                        <PasswordBox x:Name="pbConfirmPassword" 
                                     Padding="15,0" 
                                     FontSize="15" 
                                     Background="Transparent" 
                                     BorderThickness="0" 
                                     Foreground="{StaticResource TextPrimary}"
                                     VerticalContentAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="tbPasswordRequirements" 
                               Text="Пароль должен содержать минимум 6 символов" 
                               Foreground="{StaticResource TextSecondary}" 
                               FontSize="12" 
                               Margin="0,12,0,0"/>
                    <Button Content="Сохранить новый пароль" 
                            Height="50" 
                            Background="{StaticResource SuccessColor}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,30,0,0" 
                            Click="BtnSaveNewPassword_Click"/>
                </StackPanel>
                
                <!-- Двухфакторная аутентификация -->
                <StackPanel x:Name="spTwoFactor" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Двухфакторная аутентификация" 
                               FontSize="26" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" 
                               Margin="0,0,0,30"/>
                    <Border Background="{StaticResource PrimaryColor}" 
                            Opacity="0.15" 
                            CornerRadius="10" 
                            Padding="22" 
                            Margin="0,0,0,25" 
                            BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="📧 Код отправлен на вашу почту" 
                                       FontWeight="Bold" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       FontSize="16" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,12"/>
                            <TextBlock x:Name="tbTwoFactorEmail" 
                                       Foreground="{StaticResource PrimaryColor}" 
                                       FontSize="15" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Код подтверждения" 
                               FontSize="14" 
                               Foreground="{StaticResource TextSecondary}" 
                               Margin="0,0,0,10" 
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <Border x:Name="bdrTwoFactorCode" 
                            Background="{StaticResource DarkCard}" 
                            BorderBrush="{StaticResource PrimaryColor}" 
                            BorderThickness="2" 
                            CornerRadius="12" 
                            Height="60" 
                            Margin="0,0,0,10" 
                            HorizontalAlignment="Center" 
                            Width="180">
                        <TextBox x:Name="tbTwoFactorCode" 
                                 Padding="10,0" 
                                 FontSize="24" 
                                 FontWeight="Bold" 
                                 MaxLength="4" 
                                 CharacterCasing="Upper" 
                                 TextAlignment="Center" 
                                 Background="Transparent" 
                                 BorderThickness="0" 
                                 Foreground="{StaticResource TextPrimary}"
                                 VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Content="Подтвердить" 
                            Height="50" 
                            Background="{StaticResource PrimaryColor}" 
                            Foreground="White" 
                            BorderThickness="0" 
                            FontSize="15" 
                            FontWeight="Bold" 
                            Cursor="Hand" 
                            Margin="0,30,0,0" 
                            Click="BtnConfirmTwoFactor_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
