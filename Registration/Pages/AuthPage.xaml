<Page x:Class="Registration.Pages.AuthPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Авторизация" Background="{StaticResource DarkBackground}" Width="900" Height="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.ColumnSpan="3" Opacity="0.05">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Grid.Column="1" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" CornerRadius="16" Margin="20" Padding="40" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.4" Color="Black"/>
            </Border.Effect>

            <Grid VerticalAlignment="Center">

                <StackPanel x:Name="spMainAuth" Visibility="Visible">
                    <TextBlock Text="Авторизация" FontSize="36" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" Margin="0,0,0,40"/>

                    <TextBlock Text="Логин" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,15">
                        <TextBox x:Name="tbLogin" Padding="15,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Пароль" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,15,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="10" Height="50" Margin="0,0,0,15">
                        <PasswordBox x:Name="tbPassword" Padding="15,0" FontSize="15" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"/>
                    </Border>

                    <Grid x:Name="brCaptcha" Visibility="Collapsed" Margin="0,15,0,0">
                        <Border Background="{StaticResource WarningColor}" Opacity="0.15" CornerRadius="10" BorderBrush="{StaticResource WarningColor}" BorderThickness="1"/>
                        <StackPanel Margin="18">
                            <TextBlock x:Name="tblCaptcha" Text="КАПЧА" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,12" Foreground="{StaticResource WarningColor}"/>
                            <TextBox x:Name="tbCaptcha" Height="40" TextAlignment="Center" FontSize="16"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="tbBlockTimer" Visibility="Collapsed" Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Center" Margin="0,10"/>

                    <Grid Margin="0,30,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnEnterGuest" Grid.Column="0" Content="Гость" Height="50" Click="btnEnterGuest_Click"/>
                        <Button x:Name="btnEnter" Grid.Column="2" Content="Войти" Height="50" Background="{StaticResource PrimaryColor}" Foreground="White" Click="BtnEnter_Click"/>
                    </Grid>

                    <Button x:Name="BtnForgotPassword" Content="Забыли пароль?" Background="Transparent" Foreground="{StaticResource PrimaryColor}" Click="BtnForgotPassword_Click"/>
                    <Button x:Name="btnGoToRegister" Content="Нет аккаунта?" Background="Transparent" Foreground="{StaticResource PrimaryColor}" Click="BtnGoToRegister_Click"/>
                </StackPanel>

                <StackPanel x:Name="spTwoFactor" Visibility="Collapsed" Margin="0,0,0,20">
                    <TextBlock Text="Подтверждение входа" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <Border Background="{StaticResource PrimaryColor}" Opacity="0.1" CornerRadius="10" Margin="0,0,0,20" Padding="15">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="White">
            <Run Text="Код отправлен на почту:"/>
            <LineBreak/>
            <Run x:Name="tbTwoFactorEmail" FontWeight="Bold" Foreground="#6366F1"/>
                        </TextBlock>
                    </Border>

                    <TextBlock Text="Введите 4-значный код" FontSize="14" Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <Border Background="#1E1E1E" BorderBrush="{StaticResource PrimaryColor}" BorderThickness="2" CornerRadius="10" Height="70" Width="180" HorizontalAlignment="Center">
                        <TextBox x:Name="tbTwoFactorCode" FontSize="16" FontWeight="Bold" Foreground="White" CaretBrush="White" Background=" Transparent" BorderThickness="0" TextAlignment="Center"  VerticalContentAlignment="Center" MaxLength="4" InputScope="Number"/>
                    </Border>
                    <Button Content="Подтвердить" Height="50" Background="#6366F1" Foreground="White" FontWeight="Bold" Margin="0,25,0,10" Click="BtnConfirmTwoFactor_Click" Cursor="Hand"/>
                    <Button Content="Отмена" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Click="BackToAuth_Click" Cursor="Hand"/>
                </StackPanel>

                <StackPanel x:Name="spForgotPasswordEmail" Visibility="Collapsed">
                    <Button Content="← Назад" Click="BackToAuth_Click" HorizontalAlignment="Left" Background="Transparent"/>
                    <TextBlock Text="Восстановление" FontSize="24" HorizontalAlignment="Center" Margin="0,20"/>
                    <TextBox x:Name="tbRecoveryEmail" Height="50" Margin="0,10"/>
                    <Button Content="Отправить код" Height="50" Click="BtnSendRecoveryCode_Click"/>
                </StackPanel>

                <StackPanel x:Name="spRecoveryCode" Visibility="Collapsed">
                    <TextBlock Text="Введите код" FontSize="24" HorizontalAlignment="Center" Margin="0,20"/>
                    <TextBox x:Name="tbRecoveryCode" Height="50" MaxLength="4" TextAlignment="Center"/>
                    <Button Content="Проверить" Height="50" Margin="0,20" Click="BtnConfirmRecoveryCode_Click"/>
                </StackPanel>

                <StackPanel x:Name="spNewPassword" Visibility="Collapsed">
                    <PasswordBox x:Name="pbNewPassword" Height="50" Margin="0,5"/>
                    <PasswordBox x:Name="pbConfirmPassword" Height="50" Margin="0,5"/>
                    <Button Content="Сохранить" Height="50" Click="BtnSaveNewPassword_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>