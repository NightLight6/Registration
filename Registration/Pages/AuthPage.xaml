<Page x:Class="Registration.Pages.AuthPage" 
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
      Title="Авторизация" Background="{StaticResource DarkBackground}" Width="900" Height="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Rectangle Grid.ColumnSpan="3" Opacity="0.05">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#6366F1" Offset="0"/>
                    <GradientStop Color="#8B5CF6" Offset="1"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Border Grid.Column="1" Background="{StaticResource DarkSurface}" BorderBrush="{StaticResource BorderColor}" 
                BorderThickness="1" CornerRadius="20" Margin="10" Padding="30" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/>
            </Border.Effect>

            <Grid VerticalAlignment="Center">

                <StackPanel x:Name="spMainAuth" Visibility="Visible">
                    <TextBlock Text="Вход в систему" FontSize="32" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" 
                               HorizontalAlignment="Center" Margin="0,0,0,30"/>

                    <TextBlock Text="Логин" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70" Margin="0,0,0,20">
                        <TextBox x:Name="tbLogin" Padding="20,0" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Пароль" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70" Margin="0,0,0,20">
                        <PasswordBox x:Name="tbPassword" Padding="20,0" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" VerticalContentAlignment="Center"/>
                    </Border>

                    <StackPanel x:Name="brCaptcha" Visibility="Collapsed" Margin="0,10,0,20">
                        <Border Background="#2D2D3D" CornerRadius="12" Padding="15" Margin="0,0,0,10" BorderBrush="{StaticResource WarningColor}" BorderThickness="1">
                            <Grid>
                                <TextBlock x:Name="tblCaptcha" Text="CAPTCHA" FontSize="32" FontWeight="ExtraBold" 
                                           HorizontalAlignment="Center" Foreground="{StaticResource WarningColor}" FontStyle="Italic">
                                    <TextBlock.Effect>
                                        <BlurEffect Radius="1"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                                <Line X1="0" Y1="20" X2="400" Y2="10" Stroke="{StaticResource WarningColor}" StrokeThickness="1" Opacity="0.3"/>
                            </Grid>
                        </Border>
                        <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70">
                            <TextBox x:Name="tbCaptcha" FontSize="16" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextPrimary}" CaretBrush="White" Tag="Введите код с картинки"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="tbBlockTimer" Visibility="Collapsed" Foreground="{StaticResource ErrorColor}" HorizontalAlignment="Center" Margin="0,0,0,15" FontSize="16" FontWeight="Bold"/>

                    <Grid Margin="0,10,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="btnEnterGuest" Grid.Column="0" Content="Гость" Height="70" FontSize="18" Click="btnEnterGuest_Click" BorderThickness="1"/>
                        <Button x:Name="btnEnter" Grid.Column="2" Content="Войти" Height="70" FontSize="18" Background="{StaticResource PrimaryColor}" Foreground="White" Click="BtnEnter_Click"/>
                    </Grid>

                    <Button x:Name="BtnForgotPassword" Content="Забыли пароль?" FontSize="14" Margin="0,5" Background="Transparent" Foreground="{StaticResource PrimaryColor}" Click="BtnForgotPassword_Click"/>
                    <Button x:Name="btnGoToRegister" Content="Нет аккаунта?" FontSize="14" Background="Transparent" Foreground="{StaticResource TextSecondary}" Click="BtnGoToRegister_Click"/>
                </StackPanel>

                <StackPanel x:Name="spTwoFactor" Visibility="Collapsed">
                    <TextBlock Text="Код подтверждения" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <Border Background="{StaticResource PrimaryColor}" Opacity="0.1" CornerRadius="12" Margin="0,0,0,25" Padding="20">
                        <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="White" FontSize="16">
                            <Run Text="Код отправлен на:"/>
                            <LineBreak/>
                            <Run x:Name="tbTwoFactorEmail" FontWeight="Bold" Foreground="#6366F1"/>
                        </TextBlock>
                    </Border>
                    <Border Background="#1E1E1E" BorderBrush="{StaticResource PrimaryColor}" BorderThickness="2" CornerRadius="12" Height="80" Width="220" HorizontalAlignment="Center">
                        <TextBox x:Name="tbTwoFactorCode" FontSize="24" FontWeight="Bold" Foreground="White" CaretBrush="White" Background="Transparent" BorderThickness="0" TextAlignment="Center" VerticalContentAlignment="Center" MaxLength="4"/>
                    </Border>
                    <Button Content="Подтвердить" Height="70" FontSize="18" Background="#6366F1" Foreground="White" FontWeight="Bold" Margin="0,30,0,10" Click="BtnConfirmTwoFactor_Click"/>
                    <Button Content="Вернуться назад" Background="Transparent" Foreground="{StaticResource TextSecondary}" Click="BackToAuth_Click"/>
                </StackPanel>

                <StackPanel x:Name="spForgotPasswordEmail" Visibility="Collapsed">
                    <TextBlock Text="Восстановление" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Ваша почта" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70" Margin="0,0,0,20">
                        <TextBox x:Name="tbRecoveryEmail" Padding="20,0" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center"/>
                    </Border>
                    <Button Content="Отправить код" Height="70" FontSize="18" Background="{StaticResource PrimaryColor}" Foreground="White" Click="BtnSendRecoveryCode_Click"/>
                    <Button Content="Отмена" Margin="0,15,0,0" Background="Transparent" Foreground="{StaticResource TextSecondary}" Click="BackToAuth_Click"/>
                </StackPanel>

                <StackPanel x:Name="spRecoveryCode" Visibility="Collapsed">
                    <TextBlock Text="Проверка кода" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>
                    <TextBlock Text="Введите 4-значный код из письма" TextAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,15"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="80" Width="200" HorizontalAlignment="Center">
                        <TextBox x:Name="tbRecoveryCode" FontSize="24" FontWeight="Bold" TextAlignment="Center" VerticalContentAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="White" MaxLength="4"/>
                    </Border>
                    <Button Content="Проверить код" Height="70" FontSize="16" Margin="0,30,0,10" Background="{StaticResource PrimaryColor}" Foreground="White" Click="BtnConfirmRecoveryCode_Click"/>
                </StackPanel>

                <StackPanel x:Name="spNewPassword" Visibility="Collapsed">
                    <TextBlock Text="Новый пароль" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,25"/>

                    <TextBlock Text="Придумайте новый пароль" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70" Margin="0,0,0,15">
                        <PasswordBox x:Name="pbNewPassword" Padding="20,0" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Повторите новый пароль" FontSize="14" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8" FontWeight="SemiBold"/>
                    <Border Background="{StaticResource DarkCard}" BorderBrush="{StaticResource BorderColor}" BorderThickness="1" CornerRadius="12" Height="70" Margin="0,0,0,25">
                        <PasswordBox x:Name="pbConfirmPassword" Padding="20,0" FontSize="18" Background="Transparent" BorderThickness="0" Foreground="White" VerticalContentAlignment="Center"/>
                    </Border>

                    <Button Content="Обновить пароль" Height="70" FontSize="18" Background="{StaticResource SuccessColor}" Foreground="White" Click="BtnSaveNewPassword_Click"/>
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</Page>